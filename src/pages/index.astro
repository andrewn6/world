---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="space-y-10">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight md:text-4xl" style="letter-spacing: -0.035em;">
        Andrew Nijmeh
      </h1>
      <p class="mt-3 text-faint text-sm font-mono">Toronto</p>
    </div>

    <p class="text-base leading-relaxed max-w-md" style="color: #444;">

    </p>

    <div class="flex gap-5 text-sm">
      <a href="https://twitter.com/andrewnijmeh225" class="link">Twitter</a>
      <a href="https://github.com/andrewn6" class="link">GitHub</a>
      <a href="mailto:andrew@shipsidekick.com" class="link">Mail</a>
      <a href="https://www.linkedin.com/in/andrewnijmeh/" class="link">LinkedIn</a>
    </div>
  </div>
</Layout>

<style>
  .link {
    color: #111;
    text-decoration: none;
    padding-bottom: 1px;
    border-bottom: 1px solid #ddd;
    transition: border-color 0.2s ease;
  }

  .link:hover {
    border-color: #111;
  }
</style>
